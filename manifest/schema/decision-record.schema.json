{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fluminis-scientiae-oraculum/doctrines-rust/raw/main/manifest/schema/decision-record.schema.json",
  "title": "doctrines-rust decision-record registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "active_decision_records", "archived_decision_records"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "active_decision_records": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/activeRecord"
      }
    },
    "archived_decision_records": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/archivedRecord"
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*(?:/[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*)*$"
    },
    "trigger": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 4
      }
    },
    "common": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ADR-[0-9]{4}$"
        },
        "title": {
          "type": "string",
          "minLength": 8
        },
        "owner": {
          "type": "string",
          "minLength": 3
        },
        "scope": {
          "type": "string",
          "minLength": 3
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "activeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "owner",
        "scope",
        "status",
        "path",
        "executable_authority",
        "revalidate_on",
        "obsolete_when"
      ],
      "allOf": [{ "$ref": "#/$defs/common" }],
      "properties": {
        "id": true,
        "title": true,
        "owner": true,
        "scope": true,
        "path": true,
        "status": {
          "const": "active"
        },
        "executable_authority": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "revalidate_on": {
          "$ref": "#/$defs/trigger"
        },
        "obsolete_when": {
          "$ref": "#/$defs/trigger"
        }
      }
    },
    "archivedRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "owner", "scope", "status", "path", "archived_reason"],
      "allOf": [{ "$ref": "#/$defs/common" }],
      "properties": {
        "id": true,
        "title": true,
        "owner": true,
        "scope": true,
        "path": true,
        "status": {
          "enum": ["superseded", "expired", "archival"]
        },
        "archived_reason": {
          "type": "string",
          "minLength": 8
        },
        "superseded_by": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^ADR-[0-9]{4}$"
            }
          ]
        }
      }
    }
  }
}
