{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fluminis-scientiae-oraculum/doctrines-rust/raw/main/manifest/schema/agent-pack.schema.json",
  "title": "doctrines-rust agent pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packs"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "packs": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/pack"
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*(?:/[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*)*$",
      "minLength": 3
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "maximum_verbosity",
        "ordering",
        "canonical_sources",
        "doctrine_selections",
        "review_checklists",
        "output_path"
      ],
      "properties": {
        "id": {
          "enum": ["shared", "planner", "implementer", "reviewer", "auditor", "maintainer"]
        },
        "purpose": {
          "type": "string",
          "minLength": 20
        },
        "maximum_verbosity": {
          "enum": ["focused", "operational", "detailed", "exhaustive"]
        },
        "ordering": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "canonical_sources": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "doctrine_selections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^RUST-DOC-[0-9]{4}$"
          }
        },
        "review_checklists": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "output_path": {
          "$ref": "#/$defs/path"
        }
      }
    }
  }
}
